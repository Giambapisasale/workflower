# Copia in .env (accanto a docker-compose.yml) e riempi.  NON committare .env.
# --- obbligatorie ---
JWT_SECRET=cambia-questa-stringa-lunga-e-casuale
# Famiglia OpenAI gpt-5.6: T1 = "sol" (SOTA), T2 = "terra" (medio). Vision-capable.
LLM_T1_MODEL=openai/gpt-5.6-sol
LLM_T2_MODEL=openai/gpt-5.6-terra
# almeno una chiave provider, coerente con i modelli scelti
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# --- rete / TLS (Caddy) ---
# dominio per HTTPS automatico (es. demo.miosito.it) oppure :80 per la prova
SITE_ADDRESS=:80
# --- opzionali ---
LOG_LEVEL=INFO
DIAGNOSTICA_AUTO=0
# LLM_T3_MODEL=
# --- integrazione ERP (ERPNext, ciclo passivo) — opzionale ---
# Se le tre obbligatorie non sono tutte valorizzate, la sincronizzazione verso
# l'ERP è disattivata (no-op) e Workflower funziona come prima. Vedi docs/erp-poc.md.
# Dentro al container "localhost" è il container stesso: per un ERPNext sullo stesso
# host usa host.docker.internal (Docker Desktop) o l'IP/nome-servizio raggiungibile.
# ERP_BASE_URL=https://erp.miosito.it
# ERP_API_KEY=
# ERP_API_SECRET=
# Consigliate perché ERPNext le pretende sui documenti reali:
# ERP_COMPANY=La Tua Azienda           # obbligatoria per Cost Center e Purchase Invoice
# ERP_CONTO_RITENUTA=Ritenute - X      # account_head della ritenuta (X = sigla azienda)
# ERP_CONTO_IVA=IVA 22% - X            # account_head dell'IVA
# ERP_ITEM_DDT=MATERIALE-GENERICO      # articolo per le righe di Purchase Receipt (DDT)
# Derivate dalla Company se assenti (override solo se serve):
# ERP_CONTO_COSTO=                     # expense_account delle righe fattura
# ERP_PARENT_COST_CENTER=              # padre dei Cost Center dei cantieri
# ERP_SUPPLIER_GROUP=                  # gruppo dei Supplier creati
